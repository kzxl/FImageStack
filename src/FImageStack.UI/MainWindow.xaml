<Window x:Class="FImageStack.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FImageStack.UI.ViewModels"
        xmlns:core="clr-namespace:FImageStack.Core;assembly=FImageStack.Core"
        Title="FImageStack Pro — Intelligent Focus Fusion Engine"
        Height="900" Width="1450"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header Bar -->
            <RowDefinition Height="*" />    <!-- Main Work Area -->
            <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" Background="{StaticResource PrimaryAccent}" CornerRadius="6" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                    </Border>
                    <TextBlock Text="FImageStack Pro" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    <Border Background="#1E284A" BorderBrush="{StaticResource PrimaryAccent}" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="v2.0 Advanced Core" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccent}" />
                    </Border>
                </StackPanel>

                <!-- Quick Load Sample Stacks -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Quick Samples:" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="20 Frames" Style="{StaticResource ModernButton}" Command="{Binding LoadSampleStackCommand}" CommandParameter="20" Margin="0,0,6,0" Padding="10,5" />
                    <Button Content="50 Frames" Style="{StaticResource ModernButton}" Command="{Binding LoadSampleStackCommand}" CommandParameter="50" Margin="0,0,6,0" Padding="10,5" />
                    <Button Content="100 Frames" Style="{StaticResource ModernButton}" Command="{Binding LoadSampleStackCommand}" CommandParameter="100" Margin="0,0,6,0" Padding="10,5" />
                    <Button Content="200 Frames" Style="{StaticResource ModernButton}" Command="{Binding LoadSampleStackCommand}" CommandParameter="200" Margin="0,0,12,0" Padding="10,5" />

                    <Button Content="📂 Open Folder..." Style="{StaticResource ModernButton}" Command="{Binding LoadFolderCommand}" FontWeight="Bold" Padding="12,6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Work Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="230" MaxWidth="420" /> <!-- Left: Frames List -->
                <ColumnDefinition Width="*" />                                    <!-- Center: Image Canvas -->
                <ColumnDefinition Width="380" MinWidth="320" MaxWidth="480" /> <!-- Right: Config, Post-Process & Diagnostics -->
            </Grid.ColumnDefinitions>

            <!-- A. Left Sidebar: Frame List -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Frames.Count, StringFormat='Stack Frames ({0})'}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Toggle All" Style="{StaticResource ModernButton}" Command="{Binding SelectAllFramesCommand}" Padding="8,3" FontSize="11" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="4,3" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Margin="6,2" Padding="6" BorderThickness="1" BorderBrush="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#252A42" />
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource BorderDefault}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#24335E" />
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                    <Border Grid.Column="1" Height="44" Background="#0A0C14" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="4" ClipToBounds="True" Margin="0,0,8,0">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="12" />
                                        <TextBlock Text="{Binding Index, StringFormat='Frame #{0}'}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- B. Center Canvas: Multi-View Image Display -->
            <Grid Grid.Column="1" Background="#0A0C14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Multi-view Tab Headers -->
                    <RowDefinition Height="Auto" /> <!-- Split-Screen Comparison Bar (if active) -->
                    <RowDefinition Height="*" />    <!-- Main Image Viewport with Inspector HUD -->
                </Grid.RowDefinitions>

                <!-- Multi-view Tab Headers -->
                <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1" Padding="12,4,12,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="✨ Fused Output" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsFusedTabSelected}" GroupName="ViewTabs" />
                            <RadioButton Content="⚡ A/B Split View" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsSplitTabSelected}" GroupName="ViewTabs" ToolTip="Side-by-side comparison slider between Fused output and Selected frame" />
                            <RadioButton Content="🌈 Turbo Depth 3D" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsDepthTabSelected}" GroupName="ViewTabs" ToolTip="Thermal pseudo-color map (Near=Red, Far=Blue)" />
                            <RadioButton Content="🎯 Confidence Map" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsConfidenceTabSelected}" GroupName="ViewTabs" />
                            <RadioButton Content="🚫 Invalid &amp; Gaps" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsInvalidTabSelected}" GroupName="ViewTabs" ToolTip="Out-of-focus background and missing focus planes" />
                            <RadioButton Content="🍃 Motion Map" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsMotionTabSelected}" GroupName="ViewTabs" />
                            <RadioButton Content="🛡️ Artifacts &amp; Repair" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsArtifactTabSelected}" GroupName="ViewTabs" />
                            <RadioButton Content="🖼️ Source Frame" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsSourceTabSelected}" GroupName="ViewTabs" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Split-Screen Slider Bar -->
                <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1" Padding="16,6"
                        Visibility="{Binding IsSplitTabSelected, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="◀ Fused Output" Foreground="{StaticResource PrimaryAccent}" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding SplitRatio}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Source Frame ▶" Foreground="{StaticResource WarningAccent}" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Main Image Viewport with Inspector Overlay -->
                <Grid Grid.Row="2">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                            <!-- Image Display with Mouse Events for Pixel Inspector -->
                            <Image Source="{Binding DisplayBitmap}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"
                                   Cursor="Cross"
                                   MouseMove="Image_MouseMove"
                                   MouseDown="Image_MouseDown" />
                        </Grid>
                    </ScrollViewer>

                    <!-- Interactive Pixel Inspector HUD Overlay (Floating at Bottom-Left) -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16"
                            Background="#DD161926" BorderBrush="{StaticResource BorderHover}" BorderThickness="1"
                            CornerRadius="8" Padding="12,8"
                            Visibility="{Binding InspectorInfo, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource PrimaryAccent}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                <TextBlock Text="🔍 PROBE" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                            </Border>
                            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center">
                                <Run Text="Coord: (" /><Run Text="{Binding InspectorInfo.PixelX, Mode=OneWay}" FontWeight="Bold" Foreground="#FFFFFF" /><Run Text="," /><Run Text="{Binding InspectorInfo.PixelY, Mode=OneWay}" FontWeight="Bold" Foreground="#FFFFFF" /><Run Text=")  |  " />
                                <Run Text="Source Frame: " /><Run Text="{Binding InspectorInfo.SourceFrameFileName, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource PrimaryAccent}" /><Run Text="  |  " />
                                <Run Text="Depth Z: " /><Run Text="{Binding InspectorInfo.DepthZ, StringFormat='{}{0:F2}', Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource WarningAccent}" /><Run Text="  |  " />
                                <Run Text="Conf: " /><Run Text="{Binding InspectorInfo.ConfidencePercentage, StringFormat='{}{0:F0}%', Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource SuccessAccent}" /><Run Text=" " />
                                <Run Text="{Binding InspectorInfo.StatusBadge, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <Button Content="👁️ View Frame" Style="{StaticResource ModernButton}" Command="{Binding JumpToInspectedFrameCommand}" Margin="12,0,0,0" Padding="8,3" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- C. Right Sidebar: Settings, Post-Processing, Diagnostics & Metrics -->
            <Border Grid.Column="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <!-- 1. Preset Profile Card -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🎯 PRESET PROFILE" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding AvailablePresets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding SelectedPreset.Description}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 2. Strategy Card -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="⚙️ FUSION STRATEGY" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,10,0" />

                                <TextBlock Text="Fusion Algorithm:" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,0,4" />
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedMethod}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Multi-Scale Laplacian Pyramid" Tag="{x:Static core:FusionMethod.MultiScalePyramid}" IsSelected="True" />
                                    <ComboBoxItem Content="2D Wavelet DWT Fusion" Tag="{x:Static core:FusionMethod.WaveletDWT}" />
                                    <ComboBoxItem Content="Focus-Weighted Continuous Blend" Tag="{x:Static core:FusionMethod.FocusWeighted}" />
                                    <ComboBoxItem Content="Winner-Takes-All (WTA Fast)" Tag="{x:Static core:FusionMethod.WinnerTakesAll}" />
                                </ComboBox>

                                <TextBlock Text="Focus Measure Method:" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,0,4" />
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedFocusMethod}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Modified Laplacian (SML Edge)" Tag="{x:Static core:FocusMeasureMethod.ModifiedLaplacian}" IsSelected="True" />
                                    <ComboBoxItem Content="Tenengrad (Sobel Gradient)" Tag="{x:Static core:FocusMeasureMethod.Tenengrad}" />
                                    <ComboBoxItem Content="Local Variance (Texture)" Tag="{x:Static core:FocusMeasureMethod.LocalVariance}" />
                                    <ComboBoxItem Content="2D Wavelet Sharpness" Tag="{x:Static core:FocusMeasureMethod.Wavelet}" />
                                </ComboBox>

                                <TextBlock Text="Auto Alignment Mode:" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,0,4" />
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedAlignmentMode}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Similarity (Scale + Rot + Trans)" Tag="{x:Static core:AlignmentMode.Similarity}" IsSelected="True" />
                                    <ComboBoxItem Content="Affine (6-DOF Full Scale/Shear)" Tag="{x:Static core:AlignmentMode.Affine}" />
                                    <ComboBoxItem Content="Homography (8-DOF Perspective)" Tag="{x:Static core:AlignmentMode.Homography}" />
                                    <ComboBoxItem Content="Translation Only (Sub-Pixel X/Y)" Tag="{x:Static core:AlignmentMode.TranslationOnly}" />
                                    <ComboBoxItem Content="None (Locked Tripod)" Tag="{x:Static core:AlignmentMode.None}" />
                                </ComboBox>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Pyramid Decomposition Levels:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding PyramidLevels}" Foreground="{StaticResource PrimaryAccent}" HorizontalAlignment="Right" FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="3" Maximum="7" Value="{Binding PyramidLevels}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,4,0" />
                            </StackPanel>
                        </Border>

                        <!-- 3. Intelligent Diagnostics Card -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🧠 INTELLIGENT DIAGNOSTICS" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,8,0" />

                                <CheckBox Content="Motion-Aware Ghost Suppression" IsChecked="{Binding EnableMotionSuppression}" ToolTip="Prevents ghosting on leaves and moving insect parts by locking to single sharpest frame" />
                                <CheckBox Content="Stack Quality &amp; Gap Analyzer" IsChecked="{Binding EnableQualityAnalysis}" ToolTip="Evaluates focus coverage and alerts missing focal planes" />
                                <CheckBox Content="Artifact Detection &amp; Auto-Repair" IsChecked="{Binding EnableArtifactDetection}" ToolTip="Detects halos/seams and seamlessly patches from best source frames" />
                                <CheckBox Content="Bounded Tiled Processing (Large RAM)" IsChecked="{Binding EnableTiledProcessing}" ToolTip="Tiles image for memory bounded execution" />
                            </StackPanel>
                        </Border>

                        <!-- 4. Post-Processing & Clarity Card -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="🎨 POST-PROCESSING &amp; CLARITY" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryAccent}" VerticalAlignment="Center" />
                                    <Button Content="Reset" Style="{StaticResource ModernButton}" Command="{Binding ResetPostProcessingCommand}" HorizontalAlignment="Right" Padding="6,2" FontSize="10" />
                                </Grid>

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Exposure (-2 to +2 EV):" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                    <TextBlock Text="{Binding ExposureCompensation, StringFormat='{}{0:F2} EV'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                                <Slider Minimum="-2.0" Maximum="2.0" Value="{Binding ExposureCompensation}" SmallChange="0.1" />

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Contrast:" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                    <TextBlock Text="{Binding ContrastAdjustment, StringFormat='{}{0:F2}x'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                                <Slider Minimum="0.5" Maximum="2.0" Value="{Binding ContrastAdjustment}" SmallChange="0.05" />

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Clarity &amp; Micro-Contrast:" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                    <TextBlock Text="{Binding ClarityAdjustment, StringFormat='{}{0:F2}'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                                <Slider Minimum="0.0" Maximum="1.0" Value="{Binding ClarityAdjustment}" SmallChange="0.05" />

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Unsharp Mask Sharpening:" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                    <TextBlock Text="{Binding SharpeningAdjustment, StringFormat='{}{0:F2}'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                                <Slider Minimum="0.0" Maximum="1.5" Value="{Binding SharpeningAdjustment}" SmallChange="0.05" />

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Saturation:" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                    <TextBlock Text="{Binding SaturationAdjustment, StringFormat='{}{0:F2}x'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                                <Slider Minimum="0.0" Maximum="2.0" Value="{Binding SaturationAdjustment}" SmallChange="0.05" />
                            </StackPanel>
                        </Border>

                        <!-- 5. Primary Action Buttons -->
                        <Button Content="▶  START FOCUS STACKING" Style="{StaticResource PrimaryActionButton}" Command="{Binding StartStackingCommand}" Margin="0,0,0,8" Height="44" FontSize="14" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="🛑 Cancel" Style="{StaticResource ModernButton}" Command="{Binding CancelStackingCommand}" Margin="0,0,4,0" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Content="💾 Export Image" Style="{StaticResource ModernButton}" Command="{Binding ExportResultCommand}" Margin="4,0,0,0" FontWeight="Bold" />
                        </Grid>

                        <!-- 6. Quality & Performance Card -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📊 QUALITY &amp; PERFORMANCE" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,10,0" />

                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Overall Quality Score:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding QualityScoreText}" Foreground="{StaticResource SuccessAccent}" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Focus Coverage:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding FocusCoverageText}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Artifacts &amp; Repairs:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding ArtifactsReportText}" Foreground="{StaticResource WarningAccent}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Total Execution Time:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding TimingText}" Foreground="{StaticResource PrimaryAccent}" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,0">
                                    <TextBlock Text="Peak Memory Working Set:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding MemoryUsageText}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 7. Live Dynamic Histogram Card -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="📈 LUMINANCE HISTOGRAM" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,8,0" />
                                <Border Background="#0A0C14" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="4" Height="80" ClipToBounds="True" Margin="0,0,0,6">
                                    <Image Source="{Binding HistogramBitmap}" Stretch="Fill" />
                                </Border>
                                <Grid>
                                    <TextBlock Text="{Binding ShadowClippingText, StringFormat='Shadow Clip: {0}'}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBlock Text="{Binding HighlightClippingText, StringFormat='Highlight Clip: {0}'}" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentStage, StringFormat='[{0}]'}" Foreground="{StaticResource PrimaryAccent}" FontWeight="Bold" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimary}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" Height="8" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
