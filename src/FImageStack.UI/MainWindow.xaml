<Window x:Class="FImageStack.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FImageStack.UI.ViewModels"
        xmlns:core="clr-namespace:FImageStack.Core;assembly=FImageStack.Core"
        Title="FImageStack Pro — Intelligent Focus Fusion Engine"
        Height="850" Width="1380"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header Bar -->
            <RowDefinition Height="*" />    <!-- Main Work Area -->
            <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="{StaticResource PrimaryAccent}" CornerRadius="6" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#181825" />
                    </Border>
                    <TextBlock Text="FImageStack Pro" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    <Border Background="#2E334D" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="v2.0 Native Core" FontSize="11" Foreground="{StaticResource PrimaryAccent}" />
                    </Border>
                </StackPanel>

                <!-- Quick Load Sample Stacks -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Quick Samples:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="20 Frames" Style="{StaticResource ModernButton}" Command="{Binding LoadSampleStackCommand}" CommandParameter="20" Margin="0,0,6,0" Padding="8,4" />
                    <Button Content="50 Frames" Style="{StaticResource ModernButton}" Command="{Binding LoadSampleStackCommand}" CommandParameter="50" Margin="0,0,6,0" Padding="8,4" />
                    <Button Content="100 Frames" Style="{StaticResource ModernButton}" Command="{Binding LoadSampleStackCommand}" CommandParameter="100" Margin="0,0,6,0" Padding="8,4" />
                    <Button Content="200 Frames" Style="{StaticResource ModernButton}" Command="{Binding LoadSampleStackCommand}" CommandParameter="200" Margin="0,0,12,0" Padding="8,4" />

                    <Button Content="📂 Open Folder..." Style="{StaticResource ModernButton}" Command="{Binding LoadFolderCommand}" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Work Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="400" /> <!-- Left: Frames List -->
                <ColumnDefinition Width="*" />                                    <!-- Center: Image Canvas -->
                <ColumnDefinition Width="340" MinWidth="280" MaxWidth="450" /> <!-- Right: Config & Diagnostics -->
            </Grid.ColumnDefinitions>

            <!-- A. Left Sidebar: Frame List -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Frames.Count, StringFormat='Stack Frames ({0})'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Toggle All" Style="{StaticResource ModernButton}" Command="{Binding SelectAllFramesCommand}" Padding="6,2" FontSize="11" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="4,3" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Margin="4,2" Padding="6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#2A2A40" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#323554" />
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccent}" />
                                                    <Setter TargetName="itemBorder" Property="BorderThickness" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0" />

                                    <Border Grid.Column="1" Height="40" Background="#181825" CornerRadius="4" ClipToBounds="True" Margin="0,0,8,0">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimary}" FontWeight="Medium" TextTrimming="CharacterEllipsis" FontSize="12" />
                                        <TextBlock Text="{Binding Index, StringFormat='Frame #{0}'}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- B. Center Canvas: Multi-View Image Display -->
            <Grid Grid.Column="1" Background="#12121A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Multi-view Tab Headers -->
                    <RowDefinition Height="*" />    <!-- Main Image Viewport -->
                </Grid.RowDefinitions>

                <!-- Multi-view Tab Headers -->
                <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1" Padding="12,4,12,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="✨ Fused Output" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsFusedTabSelected}" GroupName="ViewTabs" />
                        <RadioButton Content="🌐 Depth Map" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsDepthTabSelected}" GroupName="ViewTabs" />
                        <RadioButton Content="🎯 Confidence Map" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsConfidenceTabSelected}" GroupName="ViewTabs" />
                        <RadioButton Content="🍃 Motion Map" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsMotionTabSelected}" GroupName="ViewTabs" />
                        <RadioButton Content="🛡️ Artifacts &amp; Repair" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsArtifactTabSelected}" GroupName="ViewTabs" />
                        <RadioButton Content="🖼️ Selected Source" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsSourceTabSelected}" GroupName="ViewTabs" />
                    </StackPanel>
                </Border>

                <!-- Main Image Viewport -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Image Display -->
                        <Image Source="{Binding DisplayBitmap}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- C. Right Sidebar: Settings & Diagnostics -->
            <Border Grid.Column="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <!-- 1. Strategy Card -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="⚙️ FUSION STRATEGY" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,10" />

                                <TextBlock Text="Fusion Algorithm:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedMethod}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Multi-Scale Laplacian Pyramid" Tag="{x:Static core:FusionMethod.MultiScalePyramid}" IsSelected="True" />
                                    <ComboBoxItem Content="Focus-Weighted Continuous Blend" Tag="{x:Static core:FusionMethod.FocusWeighted}" />
                                    <ComboBoxItem Content="Winner-Takes-All (WTA Fast)" Tag="{x:Static core:FusionMethod.WinnerTakesAll}" />
                                </ComboBox>

                                <TextBlock Text="Focus Measure Method:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedFocusMethod}" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Modified Laplacian (SML Edge)" Tag="{x:Static core:FocusMeasureMethod.ModifiedLaplacian}" IsSelected="True" />
                                    <ComboBoxItem Content="Tenengrad (Sobel Gradient)" Tag="{x:Static core:FocusMeasureMethod.Tenengrad}" />
                                </ComboBox>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Pyramid Decomposition Levels:" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding PyramidLevels}" Foreground="{StaticResource PrimaryAccent}" HorizontalAlignment="Right" FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="3" Maximum="7" Value="{Binding PyramidLevels}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,8" />
                            </StackPanel>
                        </Border>

                        <!-- 2. Intelligent Diagnostics Card -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🧠 INTELLIGENT DIAGNOSTICS" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,10" />

                                <CheckBox Content="Motion-Aware Ghost Suppression" IsChecked="{Binding EnableMotionSuppression}" ToolTip="Prevents ghosting on leaves and moving insect parts by locking to single sharpest frame" />
                                <CheckBox Content="Stack Quality &amp; Gap Analyzer" IsChecked="{Binding EnableQualityAnalysis}" ToolTip="Evaluates focus coverage and alerts missing focal planes" />
                                <CheckBox Content="Artifact Detection &amp; Auto-Repair" IsChecked="{Binding EnableArtifactDetection}" ToolTip="Detects halos/seams and seamlessly patches from best source frames" />
                                <CheckBox Content="Bounded Tiled Processing (Large RAM)" IsChecked="{Binding EnableTiledProcessing}" ToolTip="Tiles image for memory bounded execution" />
                            </StackPanel>
                        </Border>

                        <!-- 3. Primary Action Buttons -->
                        <Button Content="▶  START FOCUS STACKING" Style="{StaticResource PrimaryActionButton}" Command="{Binding StartStackingCommand}" Margin="0,0,0,8" Height="42" FontSize="14" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="🛑 Cancel" Style="{StaticResource ModernButton}" Command="{Binding CancelStackingCommand}" Margin="0,0,4,0" />
                            <Button Grid.Column="1" Content="💾 Export Image" Style="{StaticResource ModernButton}" Command="{Binding ExportResultCommand}" Margin="4,0,0,0" FontWeight="SemiBold" />
                        </Grid>

                        <!-- 4. Quality & Benchmark Metrics Card -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="📊 QUALITY &amp; PERFORMANCE" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Overall Quality Score:" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding QualityScoreText}" Foreground="{StaticResource SuccessAccent}" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Focus Coverage:" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding FocusCoverageText}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Artifacts &amp; Repairs:" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding ArtifactsReportText}" Foreground="{StaticResource WarningAccent}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Total Execution Time:" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding TimingText}" Foreground="{StaticResource PrimaryAccent}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,0">
                                    <TextBlock Text="Peak Memory Working Set:" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding MemoryUsageText}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentStage, StringFormat='[{0}]'}" Foreground="{StaticResource PrimaryAccent}" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" Height="8" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
