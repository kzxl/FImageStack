<Window x:Class="FImageStack.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FImageStack.UI.ViewModels"
        xmlns:core="clr-namespace:FImageStack.Core;assembly=FImageStack.Core"
        xmlns:retouch="clr-namespace:FImageStack.Core.Retouch;assembly=FImageStack.Core"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="FImageStack Pro — Intelligent Focus Fusion Engine"
        Height="950" Width="1480"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="P" Modifiers="Alt" Command="{Binding ToggleFocusPeakingCommand}" />
    </Window.InputBindings>

    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header Bar -->
            <RowDefinition Height="*" />    <!-- Main Work Area -->
            <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" Background="{StaticResource PrimaryAccent}" CornerRadius="6" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                    </Border>
                    <TextBlock Text="FImageStack Pro" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    <Border Background="#1E284A" BorderBrush="{StaticResource PrimaryAccent}" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="v2.0 Advanced Core" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccent}" />
                    </Border>
                </StackPanel>

                <!-- Quick Load Sample Stacks & Diagnostic Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pre-Render Scorecard Badge -->
                    <Border Background="#0F172A" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0" Padding="8,4" ToolTip="{Binding ScorecardSummaryText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ScorecardBadgeText}" FontWeight="Bold" FontSize="11" Foreground="#22C55E" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Pre-Stack Diagnostic Hunter Button -->
                    <Button Content="🎯 Hunt Artifacts" Style="{StaticResource ModernButton}" Command="{Binding HuntArtifactsCommand}" Background="#3B0764" BorderBrush="#A855F7" Foreground="#F3E8FF" FontWeight="Bold" Margin="0,0,12,0" Padding="12,6" ToolTip="Pre-stack diagnostic scan in 1s for ghosting, halos, blur, and motion" />

                    <Button Content="📁 Save Project..." Style="{StaticResource ModernButton}" Command="{Binding SaveProjectCommand}" Background="#1E1B4B" BorderBrush="#6366F1" Foreground="#C7D2FE" FontWeight="Bold" Margin="0,0,6,0" Padding="12,6" ToolTip="Save non-destructive *.fstack project package with zero-recomputation cache" />
                    <Button Content="📂 Open Project..." Style="{StaticResource ModernButton}" Command="{Binding OpenProjectCommand}" Background="#0F172A" BorderBrush="#38BDF8" Foreground="#E0F2FE" FontWeight="Bold" Margin="0,0,10,0" Padding="12,6" ToolTip="Open existing *.fstack project package instantly without recomputing" />

                    <Button Content="📁 Open Folder..." Style="{StaticResource ModernButton}" Command="{Binding LoadFolderCommand}" FontWeight="Bold" Padding="12,6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Work Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="250" MaxWidth="440" /> <!-- Left: Frames List with Priority Weights -->
                <ColumnDefinition Width="*" />                                    <!-- Center: Image Canvas with HUD -->
                <ColumnDefinition Width="390" MinWidth="320" MaxWidth="500" /> <!-- Right: Config, Retouch & Diagnostics -->
            </Grid.ColumnDefinitions>

            <!-- A. Left Sidebar: Frame List & Priority Weights -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Frames.Count, StringFormat='Frames ({0})'}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="⚡ Cull" Style="{StaticResource ModernButton}" Command="{Binding AutoCullBadFramesCommand}" ToolTip="Automatically uncheck all bad/duplicate frames" Padding="6,3" FontSize="11" Margin="0,0,4,0" Foreground="{StaticResource WarningAccent}" />
                            <Button Grid.Column="2" Content="Toggle" Style="{StaticResource ModernButton}" Command="{Binding SelectAllFramesCommand}" Padding="6,3" FontSize="11" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="4,2" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Margin="4,2" Padding="6" BorderThickness="1" BorderBrush="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#252A42" />
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource BorderDefault}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#24335E" />
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBackgroundColorHex}" BorderBrush="{Binding StatusBorderColorHex}" BorderThickness="1" CornerRadius="5" Padding="4" ToolTip="{Binding QualityTooltip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0" />

                                        <Border Grid.Column="1" Height="44" Background="#0A0C14" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="4" ClipToBounds="True" Margin="0,0,8,0">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,0,50,0" />
                                                <TextBlock Text="{Binding QualityBadge}" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusBorderColorHex}" />
                                            </Grid>
                                            <Grid Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Index, StringFormat='Frame #{0}'}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                                <TextBlock Text="{Binding PriorityWeight, StringFormat='Weight: {0:F1}x'}" Foreground="{StaticResource PrimaryAccent}" FontSize="11" HorizontalAlignment="Right" FontWeight="Medium" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- B. Center Canvas: Multi-View Image Display -->
            <Grid Grid.Column="1" Background="#0A0C14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Multi-view Tab Headers -->
                    <RowDefinition Height="Auto" /> <!-- Split-Screen Comparison Bar (if active) -->
                    <RowDefinition Height="*" />    <!-- Main Image Viewport with Inspector HUD -->
                </Grid.RowDefinitions>

                <!-- Multi-view Tab Headers -->
                <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1" Padding="12,4,12,0">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,180,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="✨ Fused Output" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsFusedTabSelected}" GroupName="ViewTabs" />
                                <RadioButton Content="⚡ A/B Split View" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsSplitTabSelected}" GroupName="ViewTabs" ToolTip="Side-by-side comparison slider between Fused output and Selected frame" />
                                <RadioButton Content="🌈 Turbo Depth 3D" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsDepthTabSelected}" GroupName="ViewTabs" ToolTip="Thermal pseudo-color map (Near=Red, Far=Blue)" />
                                <RadioButton Content="🎯 Confidence Map" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsConfidenceTabSelected}" GroupName="ViewTabs" />
                                <RadioButton Content="🚫 Invalid &amp; Gaps" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsInvalidTabSelected}" GroupName="ViewTabs" ToolTip="Out-of-focus background and missing focus planes" />
                                <RadioButton Content="🍃 Motion Map" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsMotionTabSelected}" GroupName="ViewTabs" />
                                <RadioButton Content="🌐 DOF Volume Map" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsDofVolumeTabSelected}" GroupName="ViewTabs" ToolTip="Focus Volume Depth-of-Field thickness and focus coverage map" />
                                <RadioButton Content="🛡️ Artifacts &amp; Repair" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsArtifactTabSelected}" GroupName="ViewTabs" />
                                <RadioButton Content="🌊 Focus Wave" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsFocusWaveTabSelected}" GroupName="ViewTabs" ToolTip="2D Spatio-Temporal Focus Wave Graph and Step Uniformity Visualizer" />
                                <RadioButton Content="🎯 Virtual DOF" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsVirtualDofTabSelected}" GroupName="ViewTabs" ToolTip="Post-capture interactive refocus and synthetic aperture bokeh control" />
                                <RadioButton Content="🧪 A/B Stack Lab" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsStackLabTabSelected}" GroupName="ViewTabs" ToolTip="Compare 5 stacking algorithms side-by-side with synchronized 100% zoom" />
                                <RadioButton Content="🖼️ Source Frame" Style="{StaticResource TabRadioButton}" IsChecked="{Binding IsSourceTabSelected}" GroupName="ViewTabs" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Resolution Proxy Badge -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,0,4">
                            <TextBlock Text="{Binding ResolutionBadgeText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Split-Screen Slider Bar -->
                <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1" Padding="16,6"
                        Visibility="{Binding IsSplitTabSelected, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="◀ Fused Output" Foreground="{StaticResource PrimaryAccent}" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding SplitRatio}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Source Frame ▶" Foreground="{StaticResource WarningAccent}" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Virtual DOF & Synthetic Bokeh Bar -->
                <Border Grid.Row="1" Background="#131627" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1" Padding="16,8"
                        Visibility="{Binding IsVirtualDofTabSelected, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Khẩu độ ảo:" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0.1" Maximum="2.0" Value="{Binding VirtualAperture}" VerticalAlignment="Center" SmallChange="0.05" />
                        
                        <TextBlock Grid.Column="2" Text="Z-Min:" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" Margin="16,0,8,0" VerticalAlignment="Center" />
                        <Slider Grid.Column="3" Minimum="0" Maximum="30" Value="{Binding VirtualDofMin}" VerticalAlignment="Center" SmallChange="0.5" />

                        <TextBlock Grid.Column="4" Text="Z-Max:" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" Margin="16,0,8,0" VerticalAlignment="Center" />
                        <Slider Grid.Column="5" Minimum="0" Maximum="50" Value="{Binding VirtualDofMax}" VerticalAlignment="Center" SmallChange="0.5" />

                        <Button Grid.Column="7" Content="⚡ Re-Render Bokeh" Style="{StaticResource ModernButton}" Command="{Binding ApplyVirtualDofCommand}" Background="#0284C7" BorderBrush="#38BDF8" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,4" />
                    </Grid>
                </Border>

                <!-- A/B Stack Lab Control Bar -->
                <Border Grid.Row="1" Background="#1B122C" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1" Padding="16,8"
                        Visibility="{Binding IsStackLabTabSelected, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🧪 A/B STACK LAB: " FontWeight="Bold" Foreground="{StaticResource WarningAccent}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LabSummaryText}" Foreground="{StaticResource TextPrimary}" FontWeight="Medium" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="🚀 Run Multi-Algorithm Lab" Style="{StaticResource ModernButton}" Command="{Binding RunStackLabCommand}" Background="#4C1D95" BorderBrush="#8B5CF6" Foreground="#EDE9FE" FontWeight="Bold" Padding="14,6" />
                    </Grid>
                </Border>

                <!-- Main Image Viewport with Inspector & Retouch Drawing -->
                <Grid Grid.Row="2">
                    <!-- 1. Regular Image Viewport with Zoom Scale Transform -->
                    <ScrollViewer x:Name="ImageScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                                  PreviewMouseDown="ImageScrollViewer_PreviewMouseDown"
                                  PreviewMouseMove="ImageScrollViewer_PreviewMouseMove"
                                  PreviewMouseUp="ImageScrollViewer_PreviewMouseUp">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
                            </Grid.LayoutTransform>

                            <!-- Image Display with Mouse Events for Retouch Painting and Pixel Inspector -->
                            <Image x:Name="MainDisplayImage"
                                   Source="{Binding DisplayBitmap}"
                                   Stretch="None"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Cursor="Cross"
                                   MouseMove="Image_MouseMove"
                                   MouseDown="Image_MouseDown" />
                        </Grid>
                    </ScrollViewer>

                    <!-- Floating Zoom Controls HUD Toolbar (Top-Right) -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                            Background="#DD0F172A" BorderBrush="{StaticResource BorderHover}" BorderThickness="1"
                            CornerRadius="8" Padding="6,4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.5" Color="#000000" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="➖" Style="{StaticResource ModernButton}" Command="{Binding ZoomOutCommand}" Padding="6,3" FontSize="11" ToolTip="Zoom Out (Ctrl + Wheel Down)" Margin="0,0,3,0" />
                            <Border Background="#1E293B" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,3,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ZoomScalePercentText}" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" Width="42" TextAlignment="Center" />
                            </Border>
                            <Button Content="➕" Style="{StaticResource ModernButton}" Command="{Binding ZoomInCommand}" Padding="6,3" FontSize="11" ToolTip="Zoom In (Ctrl + Wheel Up)" Margin="0,0,4,0" />

                            <Rectangle Width="1" Height="16" Fill="{StaticResource BorderDefault}" Margin="2,0,4,0" />

                            <Button Content="Fit" Style="{StaticResource ModernButton}" Command="{Binding ZoomFitCommand}" Padding="6,3" FontSize="10" FontWeight="SemiBold" ToolTip="Fit Image in Viewport" Margin="0,0,2,0" />
                            <Button Content="1:1" Style="{StaticResource ModernButton}" Command="{Binding ZoomActualSizeCommand}" Padding="6,3" FontSize="10" FontWeight="Bold" ToolTip="100% Actual Pixel Resolution" Margin="0,0,2,0" />
                            <Button Content="2:1" Style="{StaticResource ModernButton}" Command="{Binding Zoom200Command}" Padding="6,3" FontSize="10" FontWeight="Bold" ToolTip="200% Pixel Peep Focus" Margin="0,0,4,0" />

                            <Rectangle Width="1" Height="16" Fill="{StaticResource BorderDefault}" Margin="2,0,4,0" />

                            <!-- Focus Peaking HUD Toggle Button (Alt+P) -->
                            <Button Content="⚡ Peaking"
                                    Style="{StaticResource ModernButton}"
                                    Command="{Binding ToggleFocusPeakingCommand}"
                                    Padding="8,3" FontSize="10" FontWeight="Bold"
                                    Foreground="#22C55E"
                                    ToolTip="Toggle Focus Peaking Overlay (Alt+P) to highlight in-focus edges" />
                        </StackPanel>
                    </Border>

                    <!-- 2. Focus Wave Visualizer Panel -->
                    <Border Background="#07090E" Padding="20" Visibility="{Binding IsFocusWaveTabSelected, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🌊 2D SPATIO-TEMPORAL FOCUS WAVE GRAPH" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding FocusWaveSummaryText}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#042F2E" BorderBrush="#14B8A6" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Step Uniformity: " Foreground="#5EEAD4" FontSize="12" />
                                                <TextBlock Text="{Binding StepUniformityScoreText}" FontWeight="Bold" Foreground="#2DD4BF" FontSize="13" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ASCII Wave Graph Monospace Render -->
                                <Border Background="#030712" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <TextBox Text="{Binding FocusWaveAsciiGraph, Mode=OneWay}" FontFamily="Consolas, Monospace" FontSize="12" Foreground="#4ADE80" Background="Transparent" BorderThickness="0" IsReadOnly="True" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 3. A/B Stack Lab Matrix Grid -->
                    <Border Background="#07090E" Padding="16" Visibility="{Binding IsStackLabTabSelected, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding LabSlots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="380" Background="#0F172A" BorderBrush="{StaticResource BorderHover}" BorderThickness="1" CornerRadius="8" Margin="10" Padding="14">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding AlgorithmTitle}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryAccent}" VerticalAlignment="Center" />
                                                        <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding CompositeScore, StringFormat='Score: {0:F1} pts'}" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Stack Result Thumbnail -->
                                                    <Border Height="180" Background="#05070E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" ClipToBounds="True">
                                                        <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>

                                                    <!-- Scores Breakdown -->
                                                    <Grid Margin="0,0,0,3">
                                                        <TextBlock Text="Sharpness: " Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                        <TextBlock Text="{Binding SharpnessScore, StringFormat='{}{0:F1} pts'}" Foreground="{StaticResource SuccessAccent}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,3">
                                                        <TextBlock Text="Smoothness SNR: " Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                        <TextBlock Text="{Binding SmoothnessSnrScore, StringFormat='{}{0:F1} pts'}" Foreground="{StaticResource PrimaryAccent}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,3">
                                                        <TextBlock Text="Artifact-Free: " Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                        <TextBlock Text="{Binding ArtifactFreeScore, StringFormat='{}{0:F1} pts'}" Foreground="{StaticResource WarningAccent}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBlock Text="Speed Duration: " Foreground="{StaticResource TextMuted}" FontSize="11" />
                                                        <TextBlock Text="{Binding RenderDurationText}" Foreground="#CBD5E1" HorizontalAlignment="Right" FontSize="11" FontFamily="Consolas, Monospace" />
                                                    </Grid>

                                                    <Button Content="✓ Adopt as Master Output" Style="{StaticResource ModernButton}" Command="{Binding DataContext.SelectLabWinnerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#1E1B4B" BorderBrush="#6366F1" Foreground="#C7D2FE" FontWeight="Bold" Padding="10,6" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Interactive Pixel Inspector HUD Overlay (Floating at Bottom-Left) -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16"
                            Background="#DD161926" BorderBrush="{StaticResource BorderHover}" BorderThickness="1"
                            CornerRadius="8" Padding="12,8"
                            Visibility="{Binding InspectorInfo, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource PrimaryAccent}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                    <TextBlock Text="🔍 PROBE" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                                </Border>
                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center">
                                    <Run Text="Coord: (" /><Run Text="{Binding InspectorInfo.PixelX, Mode=OneWay}" FontWeight="Bold" Foreground="#FFFFFF" /><Run Text="," /><Run Text="{Binding InspectorInfo.PixelY, Mode=OneWay}" FontWeight="Bold" Foreground="#FFFFFF" /><Run Text=")  |  " />
                                    <Run Text="Peak: " /><Run Text="{Binding InspectorInfo.SourceFrameFileName, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource PrimaryAccent}" /><Run Text="  |  " />
                                    <Run Text="Sub-Frame: " /><Run Text="{Binding InspectorInfo.SubFrameIndex, StringFormat='{}{0:F2}', Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource WarningAccent}" /><Run Text="  |  " />
                                    <Run Text="DOF: " /><Run Text="{Binding InspectorInfo.DofThickness, StringFormat='{}{0:F2} slices', Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource SuccessAccent}" /><Run Text="  |  " />
                                    <Run Text="Conf: " /><Run Text="{Binding InspectorInfo.ConfidencePercentage, StringFormat='{}{0:F0}%', Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource SuccessAccent}" /><Run Text=" " />
                                    <Run Text="{Binding InspectorInfo.StatusBadge, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <Button Content="👁️ View Frame" Style="{StaticResource ModernButton}" Command="{Binding JumpToInspectedFrameCommand}" Margin="12,0,0,0" Padding="8,3" FontSize="11" />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMuted}" FontSize="11" Visibility="{Binding InspectorInfo.HasFocusCurve, Converter={StaticResource BoolToVis}}">
                                <Run Text="Focus Volume Profile: " Foreground="{StaticResource PrimaryAccent}" FontWeight="SemiBold" />
                                <Run Text="{Binding InspectorInfo.FocusCurveSummary, Mode=OneWay}" Foreground="#E2E8F0" FontFamily="Consolas, Monospace" />
                            </TextBlock>
                            <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextMuted}" FontSize="11" Visibility="{Binding InspectorInfo.HasConfidenceBreakdown, Converter={StaticResource BoolToVis}}">
                                <Run Text="Multi-Factor Confidence: " Foreground="{StaticResource SuccessAccent}" FontWeight="SemiBold" />
                                <Run Text="{Binding InspectorInfo.ConfidenceBreakdownText, Mode=OneWay}" Foreground="#E2E8F0" FontFamily="Consolas, Monospace" />
                            </TextBlock>
                            <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextMuted}" FontSize="11" Visibility="{Binding InspectorInfo.HasTransitionModel, Converter={StaticResource BoolToVis}}">
                                <Run Text="Focus Transition Model: " Foreground="{StaticResource WarningAccent}" FontWeight="SemiBold" />
                                <Run Text="{Binding InspectorInfo.TransitionModelText, Mode=OneWay}" Foreground="#FDE047" FontFamily="Consolas, Monospace" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- C. Right Sidebar: Categorized Tabs + Scrollable Inspector + Pinned Bottom Actions -->
            <Border Grid.Column="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Top Sub-Tab Navigation Bar -->
                        <RowDefinition Height="*" />    <!-- Active Tab Scrollable Content -->
                        <RowDefinition Height="Auto" /> <!-- Fixed Sticky Action Buttons Dock -->
                    </Grid.RowDefinitions>

                    <!-- 1. Right Sidebar Top Sub-Tab Bar -->
                    <Border Grid.Row="0" Background="#121524" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1" Padding="6,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" Content="⚙️ Stack" Style="{StaticResource SidebarTabRadioButton}" IsChecked="{Binding IsSidebarStackTabSelected, Mode=TwoWay}" GroupName="RightSidebarTabs" ToolTip="Focus Stacking Engine, Presets &amp; Algorithms" />
                            <RadioButton Grid.Column="1" Content="🔬 Modes" Style="{StaticResource SidebarTabRadioButton}" IsChecked="{Binding IsSidebarModesTabSelected, Mode=TwoWay}" GroupName="RightSidebarTabs" ToolTip="HDR, Noise Stacking, Astro, Drizzle &amp; 3D" />
                            <RadioButton Grid.Column="2" Content="🎨 Tone" Style="{StaticResource SidebarTabRadioButton}" IsChecked="{Binding IsSidebarColorTabSelected, Mode=TwoWay}" GroupName="RightSidebarTabs" ToolTip="Color, Clarity, Curves &amp; Histogram" />
                            <RadioButton Grid.Column="3" Content="🖌️ Retouch" Style="{StaticResource SidebarTabRadioButton}" IsChecked="{Binding IsSidebarRetouchTabSelected, Mode=TwoWay}" GroupName="RightSidebarTabs" ToolTip="Interactive Brush Painting &amp; Manual Override" />
                            <RadioButton Grid.Column="4" Content="📊 Metrics" Style="{StaticResource SidebarTabRadioButton}" IsChecked="{Binding IsSidebarMetricsTabSelected, Mode=TwoWay}" GroupName="RightSidebarTabs" ToolTip="Quality Scores, Artifacts &amp; Performance" />
                        </Grid>
                    </Border>


                    <!-- 2. Active Tab Scrollable Content Area -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,12,12,6">
                        <StackPanel>
                            <!-- Tab 0: Stacking Engine & Presets -->
                            <StackPanel Visibility="{Binding IsSidebarStackTabSelected, Converter={StaticResource BoolToVis}}">
                                <!-- 1. Preset Profile Card -->
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🎯 PRESET PROFILE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding AvailablePresets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SelectedPreset.Description}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- 2. Strategy Card -->
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ FUSION STRATEGY" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,8" />

                                        <TextBlock Text="Fusion Algorithm:" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,0,2" FontSize="11" />
                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedMethod}" Margin="0,0,0,8">
                                            <ComboBoxItem Content="Multi-Scale Laplacian Pyramid" Tag="{x:Static core:FusionMethod.MultiScalePyramid}" IsSelected="True" />
                                            <ComboBoxItem Content="HDR Focus &amp; Exposure (Mertens Hybrid)" Tag="{x:Static core:FusionMethod.HDRFocusExposure}" />
                                            <ComboBoxItem Content="2D Wavelet DWT Fusion" Tag="{x:Static core:FusionMethod.WaveletDWT}" />
                                            <ComboBoxItem Content="Focus-Weighted Continuous Blend" Tag="{x:Static core:FusionMethod.FocusWeighted}" />
                                            <ComboBoxItem Content="Winner-Takes-All (WTA Fast)" Tag="{x:Static core:FusionMethod.WinnerTakesAll}" />
                                        </ComboBox>

                                        <TextBlock Text="Focus Measure Method:" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,0,2" FontSize="11" />
                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedFocusMethod}" Margin="0,0,0,8">
                                            <ComboBoxItem Content="Modified Laplacian (SML Edge)" Tag="{x:Static core:FocusMeasureMethod.ModifiedLaplacian}" IsSelected="True" />
                                            <ComboBoxItem Content="Tenengrad (Sobel Gradient)" Tag="{x:Static core:FocusMeasureMethod.Tenengrad}" />
                                            <ComboBoxItem Content="Local Variance (Texture)" Tag="{x:Static core:FocusMeasureMethod.LocalVariance}" />
                                            <ComboBoxItem Content="2D Wavelet Sharpness" Tag="{x:Static core:FocusMeasureMethod.Wavelet}" />
                                        </ComboBox>

                                        <TextBlock Text="Auto Alignment Mode:" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,0,2" FontSize="11" />
                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedAlignmentMode}" Margin="0,0,0,8">
                                            <ComboBoxItem Content="Similarity (Scale + Rot + Trans)" Tag="{x:Static core:AlignmentMode.Similarity}" IsSelected="True" />
                                            <ComboBoxItem Content="Affine (6-DOF Full Scale/Shear)" Tag="{x:Static core:AlignmentMode.Affine}" />
                                            <ComboBoxItem Content="Homography (8-DOF Perspective)" Tag="{x:Static core:AlignmentMode.Homography}" />
                                            <ComboBoxItem Content="Translation Only (Sub-Pixel X/Y)" Tag="{x:Static core:AlignmentMode.TranslationOnly}" />
                                            <ComboBoxItem Content="None (Locked Tripod)" Tag="{x:Static core:AlignmentMode.None}" />
                                        </ComboBox>

                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Pyramid Levels:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock Text="{Binding PyramidLevels}" Foreground="{StaticResource PrimaryAccent}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11" />
                                        </Grid>
                                        <Slider Minimum="3" Maximum="7" Value="{Binding PyramidLevels}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- 3. Intelligent Diagnostics Card -->
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🧠 INTELLIGENT DIAGNOSTICS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,6" />

                                        <CheckBox Content="Motion-Aware Ghost Suppression" IsChecked="{Binding EnableMotionSuppression}" ToolTip="Prevents ghosting on leaves and moving insect parts by locking to single sharpest frame" FontSize="11" />
                                        <CheckBox Content="Local Elastic Mesh Alignment" IsChecked="{Binding EnableLocalAlignment}" ToolTip="8x8 Tiled sub-pixel motion vector mesh alignment to compensate micro-vibrations and macro 1:1 parallax" FontSize="11" />
                                        <CheckBox Content="Edge Discontinuity Reconstruction" IsChecked="{Binding EnableEdgeReconstruction}" ToolTip="Seamlessly reconstructs jagged, sheared or broken contour edges from best source frames" FontSize="11" />
                                        <CheckBox Content="Stack Quality &amp; Gap Analyzer" IsChecked="{Binding EnableQualityAnalysis}" ToolTip="Evaluates focus coverage and alerts missing focal planes" FontSize="11" />
                                        <CheckBox Content="Artifact Detection &amp; Auto-Repair" IsChecked="{Binding EnableArtifactDetection}" ToolTip="Detects halos/seams and seamlessly patches from best source frames" FontSize="11" />
                                        <CheckBox Content="Memory-Bounded Tiled Processing" IsChecked="{Binding EnableTiledProcessing}" ToolTip="Partitions ultra high-res gigapixel sequences (100MP+) into bounded memory tiles" FontSize="11" />

                                        <StackPanel Visibility="{Binding EnableTiledProcessing, Converter={StaticResource BoolToVis}}" Margin="16,4,0,0">
                                            <TextBlock Text="Tile Grid Block Size:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2" />
                                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding TileSize}" Margin="0,0,0,4">
                                                <ComboBoxItem Content="4096 × 4096 (Gigapixel 100MP+)" Tag="4096" IsSelected="True" />
                                                <ComboBoxItem Content="2048 × 2048 (Balanced 50MP)" Tag="2048" />
                                                <ComboBoxItem Content="1024 × 1024 (Low-RAM 16GB)" Tag="1024" />
                                                <ComboBoxItem Content="512 × 512 (Micro-Bounded 8GB)" Tag="512" />
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 4. Hardware & GPU Acceleration Card -->
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="⚡ HARDWARE ACCELERATION" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryAccent}" VerticalAlignment="Center" />
                                            <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding GpuStatusBadgeText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="9" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="Compute Engine / Accelerator:" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,0,2" FontSize="11" />
                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedGpuBackend}" Margin="0,0,0,2">
                                            <ComboBoxItem Content="Auto (DirectCompute / DirectML Fast)" Tag="{x:Static core:GpuBackendType.Auto}" IsSelected="True" />
                                            <ComboBoxItem Content="DirectCompute (DirectX 12 Shader)" Tag="{x:Static core:GpuBackendType.DirectCompute}" />
                                            <ComboBoxItem Content="DirectML (Neural &amp; Tensor Core)" Tag="{x:Static core:GpuBackendType.DirectML}" />
                                            <ComboBoxItem Content="NVIDIA CUDA Hardware Stream" Tag="{x:Static core:GpuBackendType.Cuda}" />
                                            <ComboBoxItem Content="CPU Multi-Thread AVX2 SIMD" Tag="{x:Static core:GpuBackendType.CpuSimd}" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 1: Computational Imaging Modes & Tools -->
                            <StackPanel Visibility="{Binding IsSidebarModesTabSelected, Converter={StaticResource BoolToVis}}">
                                <!-- 1. Computational Photography Mode Selector -->
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🔬 COMPUTATIONAL PHOTOGRAPHY MODE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,6" />
                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedStackType}" Margin="0,0,0,6">
                                            <ComboBoxItem Content="🔍 Focus Stacking (All-In-Focus &amp; 3D)" Tag="{x:Static core:StackType.FocusStack}" IsSelected="True" />
                                            <ComboBoxItem Content="✨ Statistical Noise Stacking (Clean +15dB)" Tag="{x:Static core:StackType.NoiseStack}" />
                                            <ComboBoxItem Content="🌈 Pure HDR Dynamic Range Stacking" Tag="{x:Static core:StackType.HdrStack}" />
                                            <ComboBoxItem Content="🌌 Astro Deep-Sky Stacking &amp; Alignment" Tag="{x:Static core:StackType.AstroStack}" />
                                            <ComboBoxItem Content="🔭 HST Subpixel Drizzle Super-Resolution" Tag="{x:Static core:StackType.SuperResolution}" />
                                        </ComboBox>

                                    </StackPanel>
                                </Border>

                                <!-- 2. Dedicated Parameters Card -->
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ MODE PARAMETERS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,8" />

                                        <!-- Noise Parameters -->
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="Statistical Noise Reduction:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2" />
                                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedNoiseMethod}" Margin="0,0,0,6">
                                                <ComboBoxItem Content="Kappa-Sigma Outlier Clipping" Tag="{x:Static core:NoiseStackMethod.KappaSigmaClipping}" IsSelected="True" />
                                                <ComboBoxItem Content="SIMD Arithmetic Mean (Gaussian)" Tag="{x:Static core:NoiseStackMethod.Mean}" />
                                                <ComboBoxItem Content="Median (Salt &amp; Pepper / Cosmic)" Tag="{x:Static core:NoiseStackMethod.Median}" />
                                                <ComboBoxItem Content="Winsorized Mean" Tag="{x:Static core:NoiseStackMethod.WinsorizedMean}" />
                                            </ComboBox>
                                            <Grid Margin="0,0,0,1">
                                                <TextBlock Text="Kappa Rejection Multiplier (κ):" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock Text="{Binding KappaThreshold, StringFormat='{}{0:F1}σ'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" />
                                            </Grid>
                                            <Slider Minimum="1.0" Maximum="5.0" Value="{Binding KappaThreshold}" SmallChange="0.1" Margin="0,0,0,6" />
                                        </StackPanel>

                                        <!-- HDR Parameters -->
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="HDR Radiance Merge Strategy:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2" />
                                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedHdrMethod}" Margin="0,0,0,6">
                                                <ComboBoxItem Content="Mertens Multi-Exposure Fusion" Tag="{x:Static core:HdrMergeMethod.MertensFusion}" IsSelected="True" />
                                                <ComboBoxItem Content="Debevec Physical Radiance Map" Tag="{x:Static core:HdrMergeMethod.DebevecRadiance}" />
                                            </ComboBox>
                                            <CheckBox Content="Adaptive Motion Deghosting" IsChecked="{Binding HdrDeghosting}" FontSize="11" Margin="0,0,0,6" />
                                        </StackPanel>

                                        <!-- Drizzle Parameters -->
                                        <StackPanel Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,1">
                                                <TextBlock Text="Drizzle Upsampling Scale:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock Text="{Binding DrizzleScale, StringFormat='{}{0:F1}x'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" />
                                            </Grid>
                                            <Slider Minimum="1.0" Maximum="4.0" Value="{Binding DrizzleScale}" SmallChange="0.5" Margin="0,0,0,6" />

                                            <Grid Margin="0,0,0,1">
                                                <TextBlock Text="Pixel Drop Fraction (pixfrac):" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock Text="{Binding DrizzlePixFrac, StringFormat='{}{0:F2}'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" />
                                            </Grid>
                                            <Slider Minimum="0.2" Maximum="1.0" Value="{Binding DrizzlePixFrac}" SmallChange="0.05" Margin="0,0,0,6" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 3. Optical Restoration & 3D Export Card -->
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="🌌 RESTORATION &amp; 3D EXPORT" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,8" />
                                        
                                        <Button Content="🌫️ Dehaze Output (Dark Channel)" Style="{StaticResource ModernButton}" Command="{Binding DehazeCommand}" Margin="0,0,0,6" Padding="8,5" FontWeight="SemiBold" />
                                        <Button Content="🔍 Optical Deconvolution (Richardson-Lucy)" Style="{StaticResource ModernButton}" Command="{Binding DeconvolveCommand}" Margin="0,0,0,10" Padding="8,5" FontWeight="SemiBold" />

                                        <Separator Background="{StaticResource BorderDefault}" Margin="0,0,0,8" />
                                        <TextBlock Text="3D Geometry Reconstruction:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4" />
                                        <Button Content="📐 Export 3D Mesh (.OBJ / .PLY)..." Style="{StaticResource ModernButton}" Command="{Binding Export3dMeshCommand}" Background="#064E3B" BorderBrush="#10B981" Foreground="#ECFDF5" FontWeight="Bold" Padding="10,6" ToolTip="Export 3D Point Cloud or Surface Mesh with Sobel Normals and Color mapping" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 2: Color, Clarity, Curves & Live Histogram -->
                            <StackPanel Visibility="{Binding IsSidebarColorTabSelected, Converter={StaticResource BoolToVis}}">

                                <!-- 1. Live Dynamic Histogram Card -->
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="📈 LUMINANCE HISTOGRAM" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,6" />
                                        <Border Background="#0A0C14" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="4" Height="75" ClipToBounds="True" Margin="0,0,0,6">
                                            <Image Source="{Binding HistogramBitmap}" Stretch="Fill" />
                                        </Border>
                                        <Grid>
                                            <TextBlock Text="{Binding ShadowClippingText, StringFormat='Shadow: {0}'}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                            <TextBlock Text="{Binding HighlightClippingText, StringFormat='Highlight: {0}'}" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Post-Processing & Clarity Card -->
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="🎨 POST-PROCESSING &amp; CLARITY" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryAccent}" VerticalAlignment="Center" />
                                            <Button Content="Reset" Style="{StaticResource ModernButton}" Command="{Binding ResetPostProcessingCommand}" HorizontalAlignment="Right" Padding="6,2" FontSize="10" />
                                        </Grid>

                                        <TextBlock Text="Tone Mapping Curve (HDR &amp; RAW):" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,0,2" FontSize="11" />
                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedToneMapping}" Margin="0,0,0,8">
                                            <ComboBoxItem Content="ACES Filmic (Cinema &amp; Studio)" Tag="{x:Static core:ToneMappingOperator.ACESFilmic}" IsSelected="True" />
                                            <ComboBoxItem Content="Reinhard Extended (Smooth Highlights)" Tag="{x:Static core:ToneMappingOperator.ReinhardExtended}" />
                                            <ComboBoxItem Content="AgX High-Dynamic Curve" Tag="{x:Static core:ToneMappingOperator.AgX}" />
                                            <ComboBoxItem Content="Linear RAW (Preserve Direct)" Tag="{x:Static core:ToneMappingOperator.LinearPreserve}" />
                                        </ComboBox>

                                        <Grid Margin="0,0,0,1">
                                            <TextBlock Text="Exposure:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock Text="{Binding ExposureCompensation, StringFormat='{}{0:F2} EV'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" />
                                        </Grid>
                                        <Slider Minimum="-2.0" Maximum="2.0" Value="{Binding ExposureCompensation}" SmallChange="0.1" Margin="0,0,0,6" />

                                        <Grid Margin="0,0,0,1">
                                            <TextBlock Text="Contrast:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock Text="{Binding ContrastAdjustment, StringFormat='{}{0:F2}x'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" />
                                        </Grid>
                                        <Slider Minimum="0.5" Maximum="2.0" Value="{Binding ContrastAdjustment}" SmallChange="0.05" Margin="0,0,0,6" />

                                        <Grid Margin="0,0,0,1">
                                            <TextBlock Text="Clarity &amp; Micro-Contrast:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock Text="{Binding ClarityAdjustment, StringFormat='{}{0:F2}'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" />
                                        </Grid>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding ClarityAdjustment}" SmallChange="0.05" Margin="0,0,0,6" />

                                        <Grid Margin="0,0,0,1">
                                            <TextBlock Text="Unsharp Mask Sharpening:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock Text="{Binding SharpeningAdjustment, StringFormat='{}{0:F2}'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" />
                                        </Grid>
                                        <Slider Minimum="0.0" Maximum="1.5" Value="{Binding SharpeningAdjustment}" SmallChange="0.05" Margin="0,0,0,6" />

                                        <Grid Margin="0,0,0,1">
                                            <TextBlock Text="Saturation:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock Text="{Binding SaturationAdjustment, StringFormat='{}{0:F2}x'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" />
                                        </Grid>
                                        <Slider Minimum="0.0" Maximum="2.0" Value="{Binding SaturationAdjustment}" SmallChange="0.05" Margin="0,0,0,4" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 2: Retouch & Manual Focus Override -->
                            <StackPanel Visibility="{Binding IsSidebarRetouchTabSelected, Converter={StaticResource BoolToVis}}">
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderHover}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="🖌️ RETOUCH &amp; MANUAL OVERRIDE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryAccent}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StrokesCountText}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>

                                        <CheckBox Content="Enable Brush Painting on Canvas" IsChecked="{Binding IsRetouchModeActive}" FontWeight="Bold" Foreground="{StaticResource WarningAccent}" Margin="0,0,0,8" FontSize="11" />

                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Tool Mode:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ActiveRetouchTool}" Margin="0,18,0,0">
                                                <ComboBoxItem Content="Source Brush (Override from Frame)" Tag="{x:Static retouch:RetouchToolType.SourceBrush}" IsSelected="True" />
                                                <ComboBoxItem Content="Restore (Revert to Original Fused)" Tag="{x:Static retouch:RetouchToolType.Restore}" />
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Source Frame to Paint From:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <ComboBox ItemsSource="{Binding Frames}" SelectedIndex="{Binding RetouchSourceFrameIndex}" DisplayMemberPath="FileName" Margin="0,18,0,0" />
                                        </Grid>

                                        <Grid Margin="0,4,0,1">
                                            <TextBlock Text="Brush Size:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock Text="{Binding BrushRadius, StringFormat='{}{0:F0} px'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" />
                                        </Grid>
                                        <Slider Minimum="5" Maximum="150" Value="{Binding BrushRadius}" Margin="0,0,0,6" />

                                        <Grid Margin="0,2,0,1">
                                            <TextBlock Text="Brush Feather (Soft Edge):" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock Text="{Binding BrushFeather, StringFormat='{}{0:P0}'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" />
                                        </Grid>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding BrushFeather}" SmallChange="0.05" Margin="0,0,0,6" />

                                        <Grid Margin="0,2,0,1">
                                            <TextBlock Text="Brush Opacity:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock Text="{Binding BrushOpacity, StringFormat='{}{0:P0}'}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" />
                                        </Grid>
                                        <Slider Minimum="0.1" Maximum="1.0" Value="{Binding BrushOpacity}" SmallChange="0.05" Margin="0,0,0,8" />

                                        <!-- Undo / Redo / Clear Controls -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="↩ Undo" Style="{StaticResource ModernButton}" Command="{Binding UndoRetouchCommand}" Margin="0,0,3,0" Padding="6,4" FontSize="11" />
                                            <Button Grid.Column="1" Content="↪ Redo" Style="{StaticResource ModernButton}" Command="{Binding RedoRetouchCommand}" Margin="3,0,3,0" Padding="6,4" FontSize="11" />
                                            <Button Grid.Column="2" Content="🗑️ Clear" Style="{StaticResource ModernButton}" Command="{Binding ClearRetouchCommand}" Margin="3,0,0,0" Padding="6,4" FontSize="11" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 3: Quality Metrics & Artifact Navigator -->
                            <StackPanel Visibility="{Binding IsSidebarMetricsTabSelected, Converter={StaticResource BoolToVis}}">
                                <!-- 1. Advanced Quality Analyzer Card -->
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="📊 QUALITY ANALYZER" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryAccent}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding QualityScoreText}" Foreground="{StaticResource SuccessAccent}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12" />
                                        </Grid>

                                        <!-- 5 Multi-Metric Bars -->
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Alignment Precision:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock Text="{Binding MetricAlignmentScore, StringFormat='{}{0:F0}%'}" Foreground="{StaticResource SuccessAccent}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11" />
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding MetricAlignmentScore}" Height="5" Foreground="{StaticResource SuccessAccent}" Background="#1E2337" BorderThickness="0" Margin="0,0,0,6" />

                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Focus Coverage:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock Text="{Binding MetricFocusCoverageScore, StringFormat='{}{0:F0}%'}" Foreground="{StaticResource PrimaryAccent}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11" />
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding MetricFocusCoverageScore}" Height="5" Foreground="{StaticResource PrimaryAccent}" Background="#1E2337" BorderThickness="0" Margin="0,0,0,6" />

                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Ghosting Rate:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock Text="{Binding MetricGhostingPercent, StringFormat='{}{0:F1}%'}" Foreground="{StaticResource DangerAccent}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11" />
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="20" Value="{Binding MetricGhostingPercent}" Height="5" Foreground="{StaticResource DangerAccent}" Background="#1E2337" BorderThickness="0" Margin="0,0,0,6" />

                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Halo Severity:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock Text="{Binding MetricHaloPercent, StringFormat='{}{0:F1}%'}" Foreground="{StaticResource WarningAccent}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11" />
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="20" Value="{Binding MetricHaloPercent}" Height="5" Foreground="{StaticResource WarningAccent}" Background="#1E2337" BorderThickness="0" Margin="0,0,0,6" />

                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Edge Quality:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock Text="{Binding MetricEdgeQualityScore, StringFormat='{}{0:F0}%'}" Foreground="{StaticResource SuccessAccent}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11" />
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding MetricEdgeQualityScore}" Height="5" Foreground="{StaticResource SuccessAccent}" Background="#1E2337" BorderThickness="0" Margin="0,0,0,4" />
                                    </StackPanel>
                                </Border>

                                <!-- 2. Interactive Detected Artifacts Navigator -->
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🚨 DETECTED ARTIFACT REGIONS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource WarningAccent}" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding DetectedArtifactRegions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{Binding BadgeColorHex}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TypeName}" FontWeight="Bold" FontSize="9" Foreground="#FFFFFF" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="2" Content="🎯 JUMP" Style="{StaticResource ModernButton}" Command="{Binding DataContext.JumpToArtifactRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="6,2" FontSize="10" Margin="4,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- 3. Speed & RAM Info Card -->
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                    <Grid>
                                        <TextBlock Text="{Binding TimingText, StringFormat='Speed: {0}'}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                        <TextBlock Text="{Binding MemoryUsageText, StringFormat='RAM: {0}'}" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 3. Bottom Pinned Sticky Action Dock (Always Visible) -->
                    <Border Grid.Row="2" Background="#121524" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,1,0,0" Padding="12,10">
                        <StackPanel>
                            <!-- Dual-Action Preview & Master Render Buttons -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="⚡ FAST PREVIEW" Style="{StaticResource PrimaryActionButton}" Command="{Binding StartPreviewStackCommand}" Margin="0,0,3,0" Height="40" FontSize="12" FontWeight="Bold" ToolTip="Instant proxy stack (1280px / 0.3s) for fast parameter tuning &amp; retouching" />
                                <Button Grid.Column="1" Content="🚀 FULL MASTER" Style="{StaticResource ModernButton}" Command="{Binding StartFullMasterRenderCommand}" Margin="3,0,0,0" Height="40" FontSize="12" FontWeight="Bold" Background="#2E1065" BorderBrush="#8B5CF6" Foreground="#E9D5FF" ToolTip="Full 100% native sensor resolution master render for final output" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="🛑 Cancel" Style="{StaticResource ModernButton}" Command="{Binding CancelStackingCommand}" Margin="0,0,3,0" Padding="8,5" FontWeight="SemiBold" FontSize="11" />
                                <Button Grid.Column="1" Content="💾 Export Image" Style="{StaticResource ModernButton}" Command="{Binding ExportResultCommand}" Margin="3,0,0,0" Padding="8,5" FontWeight="Bold" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentStage, StringFormat='[{0}]'}" Foreground="{StaticResource PrimaryAccent}" FontWeight="Bold" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimary}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" Height="8" />
                </Grid>
            </Grid>
        </Border>

        <!-- 4. Artifact Hunter Diagnostic Popup Modal Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#AA030712" Visibility="{Binding IsHunterPopupOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="680" Background="#0F172A" BorderBrush="#A855F7" BorderThickness="2" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎯 ARTIFACT HUNTER DIAGNOSTIC SCAN" FontWeight="Bold" FontSize="15" Foreground="#C084FC" VerticalAlignment="Center" />
                            <Border Background="#3B0764" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding HunterReport.HealthScore, StringFormat='Health: {0}%'}" FontWeight="Bold" FontSize="11" Foreground="#F3E8FF" />
                            </Border>
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource ModernButton}" Command="{Binding CloseHunterPopupCommand}" HorizontalAlignment="Right" Padding="8,4" FontWeight="Bold" />
                    </Grid>

                    <!-- 6 Risk Metric Bars -->
                    <Border Background="#030712" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding HunterReport.Metrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Type}" FontWeight="Bold" Foreground="#C084FC" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding AsciiBar}" FontFamily="Consolas, Monospace" Foreground="#38BDF8" FontSize="11" />
                                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="🚨 DETECTED ROOT-CAUSE HOTSPOTS:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource WarningAccent}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding HunterReport.Hotspots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" BorderBrush="{StaticResource BorderHover}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#3B0764" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RiskType}" FontWeight="Bold" FontSize="10" Foreground="#F3E8FF" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RootCauseDescription}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ProblematicFrameNumber, StringFormat='Frame #{0}'}" Foreground="{StaticResource WarningAccent}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="✓ Close Hunter Report" Style="{StaticResource PrimaryActionButton}" Command="{Binding CloseHunterPopupCommand}" Margin="0,12,0,0" Height="36" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
